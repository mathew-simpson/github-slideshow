{
  "mcpServers": {
    "mt5-advisor": {
      "command": "curl",
      "args": [
        "-X",
        "POST",
        "-H",
        "Content-Type: application/json",
        "-d",
        "@-",
        "https://REDACTED.ngrok-free.dev"
      ],
      "env": {
        "NGROK_ENDPOINT": "https://REDACTED.ngrok-free.dev",
        "LOCAL_ENDPOINT": "http://127.0.0.1:8080"
      }
    }
  },
  "customMcpEndpoint": {
    "name": "MT5 Expert Advisor System",
    "url": "https://REDACTED.ngrok-free.dev",
    "type": "remote-http",
    "auth": "none",
    "enabled": true,
    "description": "ngrok tunnel to local MT5 trading advisor system"
  }
}
